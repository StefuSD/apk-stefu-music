{
  "expo": {
    "name": "Stefu Music",
    "slug": "stefu-music",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7b3fcf",
      "dark": {
        "image": "./assets/splash-icon-dark.png",
        "backgroundColor": "#7b3fcf"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3a1466"
      },
      "package": "com.stefu.music",
      "versionCode": 1,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withShotsBuild",
      "./plugins/withLinks",
      "./plugins/withShortcuts",
      "./plugins/withReleaseSigning",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Player",
              "label": "Stefu Music",
              "description": "Play, pause and skip songs from the home screen",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeHeight": "110dp",
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "PlayerLarge",
              "label": "Player — large",
              "description": "Cover, song, progress and controls",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/player_large.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "Cover",
              "label": "Album art",
              "description": "Cover of the current song with play/pause",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/cover.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "Actions",
              "label": "Quick actions",
              "description": "Shuffle, mix for you, snippets, sleep timer",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "previewImage": "./assets/widgets/actions.png",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "Playlists",
              "label": "Playlists",
              "description": "Start a playlist with one tap",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/playlists.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "TopWeek",
              "label": "Top of the week",
              "description": "Most played songs this week",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/top_week.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "Stats",
              "label": "Listening stats",
              "description": "Minutes today and this week, most played artist",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widgets/stats.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "ShortSnippets",
              "label": "Snippets",
              "description": "Play song snippets",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "previewImage": "./assets/widgets/short_snippets.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "ShortMix",
              "label": "Mix for you",
              "description": "Play a mix for you",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "previewImage": "./assets/widgets/short_mix.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "ShortSleep",
              "label": "Sleep timer",
              "description": "Sleep timer, 30 minutes",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "previewImage": "./assets/widgets/short_sleep.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ]
  }
}
